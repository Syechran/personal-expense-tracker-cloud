# Koneksi PostgreSQL (wajib)
DATABASE_URL=postgres://expense:expense@localhost:5432/expense

# Aktifkan jika database terkelola mewajibkan SSL
DATABASE_SSL=false

# Wajib minimal 32 karakter saat NODE_ENV=production
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Nama cookie sesi (opsional)
SESSION_COOKIE_NAME=sid

# true jika aplikasi diakses lewat HTTPS
COOKIE_SECURE=false

PORT=5000
# NODE_ENV sengaja tidak di-set di sini. Vite build otomatis production;
# set NODE_ENV=production lewat environment server saat deploy.

# Maksimal koneksi pool PostgreSQL
PG_POOL_MAX=10
